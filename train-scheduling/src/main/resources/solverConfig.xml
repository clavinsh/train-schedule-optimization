<?xml version="1.0" encoding="UTF-8"?>
<solver xmlns="https://timefold.ai/xsd/solver" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://timefold.ai/xsd/solver https://timefold.ai/xsd/solver/solver.xsd">
    <solutionClass>com.example.domain.RollingStockSchedule</solutionClass>
    <entityClass>com.example.domain.RouteDeparture</entityClass>
    <scoreDirectorFactory>
        <constraintProviderClass>com.example.solver.TrainScheduleConstraintProvider</constraintProviderClass>
    </scoreDirectorFactory>

    <!-- Termination: stop after 5 minutes OR 60 seconds without improvement -->
    <termination>
        <secondsSpentLimit>300</secondsSpentLimit>
        <unimprovedSecondsSpentLimit>60</unimprovedSecondsSpentLimit>
    </termination>

    <!-- Construction Heuristic: build initial solution - no time limit to ensure all entities are initialized -->
    <constructionHeuristic>
        <constructionHeuristicType>FIRST_FIT_DECREASING</constructionHeuristicType>
        <!-- No termination for CH - let it finish -->
    </constructionHeuristic>

    <localSearch>
        <changeMoveSelector/>

        <acceptor>
            <lateAcceptanceSize>400</lateAcceptanceSize>
        </acceptor>

        <forager>
            <acceptedCountLimit>1</acceptedCountLimit>
        </forager>
    </localSearch>
</solver>